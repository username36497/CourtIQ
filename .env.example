# Optional: leave blank for an offline extractive demo.
# This root .env is automatically loaded by Docker Compose, not by Python.
OPENAI_API_KEY=
# Set a Responses-compatible model available to your API project.
OPENAI_MODEL=
POSTGRES_PASSWORD=local-dev-only
# For HTTPS hosting only, set COOKIE_SECURE=true.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Restrict these for any public deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
